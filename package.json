{
  "name": "nestjs-provider-type-registry",
  "version": "0.1.0",
  "description": "Type-safe decorator-driven provider registries for NestJS.",
  "license": "MIT",
  "author": "Roman Bessonov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bolkonya/nestjs-provider-type-registry.git"
  },
  "homepage": "https://github.com/bolkonya/nestjs-provider-type-registry#readme",
  "bugs": "https://github.com/bolkonya/nestjs-provider-type-registry/issues",
  "keywords": [
    "nestjs",
    "provider",
    "registry",
    "decorator",
    "dependency-injection",
    "typescript"
  ],
  "packageManager": "yarn@4.10.3",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src tsup.config.ts",
    "lint:fix": "yarn lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:ci": "NODE_OPTIONS=--experimental-vm-modules jest --ci --runInBand",
    "test:package": "yarn build && node --test test/package.test.cjs",
    "typecheck": "tsc --noEmit",
    "check": "yarn typecheck && yarn lint && yarn format:check && yarn test:ci && yarn test:package",
    "prepack": "yarn build",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.38.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "1.13.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.1",
    "tsup": "^8.5.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.39.1"
  }
}
